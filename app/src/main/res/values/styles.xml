<resources>
    <style name="Widget.OCRDroid.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
    </style>
    <!-- Overlays let code-built MaterialButtons pick a style through materialButtonStyle. -->
    <style name="ThemeOverlay.OCRDroid.TonalButton" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TonalButton</item>
    </style>
    <style name="ThemeOverlay.OCRDroid.OutlinedButton" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.OutlinedButton</item>
    </style>
    <style name="ThemeOverlay.OCRDroid.TextButton" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TextButton</item>
    </style>
    <style name="ThemeOverlay.OCRDroid.IconButton" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.IconButton.Filled.Tonal</item>
    </style>
    <style name="ThemeOverlay.OCRDroid.SegmentButton" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.OutlinedButton</item>
    </style>
    <style name="ThemeOverlay.OCRDroid.Dropdown" parent="">
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu</item>
    </style>
</resources>
